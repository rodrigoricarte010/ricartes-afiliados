# ---------------------------------------------------------------------------
# Ricartes Renda Extra — variáveis de ambiente
# ---------------------------------------------------------------------------

# Senha de acesso ao painel /admin (troque em produção!)
APP_PASSWORD=ricartes
# Segredo usado para assinar o cookie de sessão (gere um valor aleatório longo)
AUTH_SECRET=troque-este-segredo-por-um-valor-aleatorio-bem-longo

# URL pública da aplicação (usada para montar links rastreáveis e QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Deixe DB_DRIVER=file para rodar localmente sem configurar nada (grava em .data/db.json).
#
# Em produção, use qualquer Postgres:
#   DB_DRIVER=postgres  + DATABASE_URL   (Neon, Railway, Supabase, RDS, Postgres local)
#   DB_DRIVER=supabase  + as variáveis do bloco Supabase abaixo
# Se você definir apenas DATABASE_URL, o driver postgres é ativado automaticamente.
DB_DRIVER=file

# ---------------------------------------------------------------------------
# Postgres genérico (recomendado para Neon / Railway / Render)
# ---------------------------------------------------------------------------
# Exemplo Neon: postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (apenas quando DB_DRIVER=supabase)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service role) — usada somente no servidor. NUNCA exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=
